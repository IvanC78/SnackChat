<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ControladorChatPrivado"
      stylesheets="@style.css" styleClass="root"
      spacing="15" alignment="TOP_CENTER" fillWidth="true"
      style="-fx-padding: 30;"
      prefWidth="500" prefHeight="700">

    <!-- HEADER: Contact Info -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="chat-header">
        <Label fx:id="labelIcono" style="-fx-font-size: 24px;" text="👤" />
        <Label fx:id="labelContacto" styleClass="header-text" text="Usuario" style="-fx-font-size: 20px;" />
    </HBox>

    <!-- CENTER: Messages Area -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" styleClass="scroll-pane">
        <content>
            <VBox fx:id="contenedorMensajes" spacing="10" style="-fx-padding: 10;">
                <!-- Messages will be added here dynamically -->
            </VBox>
        </content>
    </ScrollPane>

    <!-- FOOTER: Message Input -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chat-footer">
        <TextField fx:id="campoMensaje" promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS" />
        <Button text="ENVIAR" onAction="#enviarMensaje" defaultButton="true" style="-fx-min-width: 80;" />
    </HBox>

</VBox>
