<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ControladorModoConexion">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label styleClass="header-text" text="SNACKCHAT" textFill="#333333">
        <font>
            <Font name="Segoe UI Bold" size="32.0" />
        </font>
    </Label>
   <Label style="-fx-font-size: 16px;" text="Selecciona tu modo de conexión:" textFill="#666666" />

    <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 30;">
        
        <!-- MODO HOST -->
        <Button fx:id="btnHost" maxWidth="300" onAction="#modoAnfitrion" style="-fx-font-size: 16px; -fx-padding: 15;" text="🏠 SER ANFITRÓN (Servidor)" />
        <Label style="-fx-font-size: 12px; -fx-text-fill: #888;" text="Inicia esto si eres el 'Jefe' de la red" />
        
        <Label text="──────── O ────────" textFill="#aaaaaa">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin></Label>

        <!-- MODO CLIENTE -->
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Unirse a otro equipo:" />
        <TextField fx:id="campoIP" maxWidth="250" promptText="Introduce la IP del Anfitrión (ej: 192.168.1.X)" style="-fx-font-size: 14px;" />
        <Button fx:id="btnCliente" maxWidth="300" onAction="#modoCliente" style="-fx-font-size: 16px; -fx-padding: 10;" text="🔗 CONECTAR" />
        
    </VBox>
   <Label fx:id="mensajeEstado" textFill="#d32f2f" />

</VBox>
