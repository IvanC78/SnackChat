<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ControladorModificarPerfilInicio"
      stylesheets="@style.css" styleClass="root"
      alignment="CENTER" spacing="20" fillWidth="false">

    <!-- HEADER / LOGO -->
    <Text styleClass="header-text" text="SnackChat" />

    <!-- PROFILE CARD -->
    <VBox styleClass="login-card" alignment="CENTER_LEFT" spacing="15">
        <Text styleClass="section-title" text="CREA TU PERFIL" />
        
        <Text text="Nombre de usuario" />
        <TextField fx:id="nombreUsuario" promptText="¿Cómo te llamarán?" maxWidth="Infinity" />
        
        <Text text="Color de perfil" />
        <ColorPicker fx:id="colorUsuario" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" />
        
        <Button fx:id="finalizarPerfil" onAction="#continuar" text="CONTINUAR" 
                maxWidth="Infinity" defaultButton="true" style="-fx-margin-top: 10;" />
    </VBox>

</VBox>
